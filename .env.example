ANTHROPIC_API_KEY=paste-your-key-here
# Optional: ANTHROPIC_MODEL=claude-haiku-5-5   (AI event import)
# Optional: VISION_MODEL=claude-opus-5-5 and VISION_EFFORT=low   (topping photo check; these are the defaults)

# Shared database. Leave empty locally to use the local.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Device PIN screen: off for local runs. It is on when deployed on Vercel, or locally with REQUIRE_PAIRING=1.
# REQUIRE_PAIRING=1
# PIN the owner types once per device (0000 if unset, local only)
OWNER_PIN=0000
# Long random string that signs device cookies; changing it un-pairs every device
DEVICE_SECRET=change-me-to-a-long-random-string
LOCATION_ID=nassau-st
# Topping bar photo check: 1 to turn it on
TOPPING_CAMERA=1
# Protects the daily photo cleanup (Vercel cron sends it automatically)
CRON_SECRET=change-me-too
# kg CO2e per pan of wasted toppings, from a cited source (leave unset to hide CO2e)
# TOPPING_CO2E_KG_PER_PAN=

# Photon messaging agent (npm run agent). Fill in from the Photon dashboard; never commit real values.
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=
# Phone numbers or handles allowed to text the agent, comma-separated
PHOTON_TEST_SENDER=
PHOTON_API_KEY=
# PHOTON_AGENT=0   # turn the agent off even when the values above are set

# Optional: BestTime.app private key, used only by `npm run besttime` (never by the site, never in the browser)
BESTTIME_PRIVATE_API_KEY=paste-your-key-here
